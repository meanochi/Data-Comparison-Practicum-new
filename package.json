{
  "name": "data-comparison-practicum",
  "version": "1.0.0",
  "description": "API להשוואת נתוני תקופות עבודה בין שורות טבלה זמנית (או קובץ DAT) לקבצי PDF",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon --exec ts-node app.ts",
    "start": "ts-node app.ts",
    "build": "tsc",
    "test": "node --require ts-node/register --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-fileupload": "^1.5.1",
    "iconv-lite": "^0.6.3",
    "joi": "^17.13.3",
    "morgan": "^1.10.0",
    "mupdf": "^1.28.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.5.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.15",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
